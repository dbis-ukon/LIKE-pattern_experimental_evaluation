+typedef char TYPCATEGORY;
+#define CARD_EST_QUERY_NUM 20000
+static double sel_ests[CARD_EST_QUERY_NUM];
+static bool sel_ests_initialized = false;
+
+extern bool ml_cardest_enabled;
