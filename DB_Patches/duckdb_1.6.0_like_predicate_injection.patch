+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/optimizer/like_selectivity.hpp
+//
+//
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb/common/string.hpp"
+#include "duckdb/common/unordered_map.hpp"
+
+namespace duckdb {
+
+class Expression;
+
+//! Optional, file-backed overrides for LIKE-filter selectivity estimation.
+//! Absent any entry for a given pattern, callers should fall back to their own
+//! existing default behavior - this class never invents a default of its own
+//! beyond DEFAULT_LIKE_SELECTIVITY, which Lookup() uses but TryLookup() does not.
+class LikeSelectivity {
+public:
+	static constexpr double DEFAULT_LIKE_SELECTIVITY = 0.2;
+
+public:
+	static LikeSelectivity &Get();
+
+	//! Look up a pattern, returning DEFAULT_LIKE_SELECTIVITY on a miss.
+	double Lookup(const string &pattern) const;
+	//! Look up a pattern; only returns true (and sets selectivity_out) on an explicit
+	//! file entry. Callers use this when a miss should mean "do nothing" rather than
+	//! "apply some default."
+	bool TryLookup(const string &pattern, double &selectivity_out) const;
+
+	//! Shared matching logic for cardinality-estimation code paths. Inspects expr for a
+	//! plain LIKE comparison ("~~") against a constant VARCHAR pattern; if the file has an
+	//! explicit override for that exact pattern, sets selectivity_out and returns true.
+	//! Returns false for anything else - including a well-formed LIKE with no configured
+	//! override - so callers never silently get a fabricated default from this call.
+	static bool TryGetLikeSelectivity(const Expression &expr, double &selectivity_out);
+
+private:
+	LikeSelectivity();
+	string GetFilePath() const;
+	void Load();
+
+	unordered_map<string, double> estimates;
+};
+
+} // namespace duckdb
