diff -ruN '--exclude=*.bak*' duckdb-clean/src/optimizer/like_selectivity.cpp duckdb/src/optimizer/like_selectivity.cpp
--- duckdb-clean/src/optimizer/like_selectivity.cpp	1970-01-01 01:00:00.000000000 +0100
+++ duckdb/src/optimizer/like_selectivity.cpp	2026-07-31 15:15:48.737618071 +0200
@@ -0,0 +1,260 @@
+#include "duckdb/optimizer/like_selectivity.hpp"
+
+#include "duckdb/planner/expression/bound_comparison_expression.hpp"
+#include "duckdb/planner/expression/bound_conjunction_expression.hpp"
+#include "duckdb/planner/expression/bound_constant_expression.hpp"
+#include "duckdb/planner/expression/bound_function_expression.hpp"
+#include "duckdb/planner/expression/bound_operator_expression.hpp"
+#include <cstdlib>
+#include <fstream>
+
+namespace duckdb {
+
+LikeSelectivity &LikeSelectivity::Get() {
+	static LikeSelectivity instance;
+	return instance;
+}
+
+LikeSelectivity::LikeSelectivity() {
+	Load();
+}
+
+string LikeSelectivity::GetFilePath() const {
+	const char *env_path = std::getenv("DUCKDB_LIKE_SELECTIVITY_FILE");
+	if (env_path && *env_path) {
+		return string(env_path);
+	}
+	return "like_selectivity.txt";
+}
+
+void LikeSelectivity::Load() {
+	std::ifstream file(GetFilePath());
+	if (!file.good()) {
+		// Optional file: absence just means every pattern uses the default.
+		return;
+	}
+
+	string line;
+	while (std::getline(file, line)) {
+		if (line.empty() || line[0] == '#') {
+			continue;
+		}
+
+		// Split on the LAST tab: LIKE patterns frequently contain spaces
+		// (e.g. "% foo bar %"), so whitespace-based tokenization is unsafe.
+		auto tab_pos = line.find_last_of('\t');
+		if (tab_pos == string::npos || tab_pos == 0) {
+			// Malformed line: skip it, but keep loading the rest of the
+			// file instead of aborting on the first bad entry.
+			continue;
+		}
+
+		auto pattern = line.substr(0, tab_pos);
+		auto value_str = line.substr(tab_pos + 1);
+
+		double value;
+		try {
+			size_t chars_consumed;
+			value = std::stod(value_str, &chars_consumed);
+			if (chars_consumed != value_str.size()) {
+				continue;
+			}
+		} catch (...) {
+			continue;
+		}
+
+		// Selectivities are probabilities: clamp defensively so a bad or
+		// adversarial file entry can't make the optimizer inflate a
+		// filtered cardinality above the pre-filter cardinality.
+		if (value < 0.0) {
+			value = 0.0;
+		} else if (value > 1.0) {
+			value = 1.0;
+		}
+
+		estimates[pattern] = value;
+	}
+}
+
+double LikeSelectivity::Lookup(const string &pattern) const {
+	auto entry = estimates.find(pattern);
+	if (entry != estimates.end()) {
+		return entry->second;
+	}
+	return DEFAULT_LIKE_SELECTIVITY;
+}
+
+bool LikeSelectivity::TryLookup(const string &pattern, double &selectivity_out) const {
+	auto entry = estimates.find(pattern);
+	if (entry == estimates.end()) {
+		return false;
+	}
+	selectivity_out = entry->second;
+	return true;
+}
+
+//! Checks whether `upper` is the FilterCombiner's standard range-encoding
+//! of a prefix pattern whose lower bound is `lower` - i.e. `upper` equals
+//! `lower` with trailing 0xFF bytes stripped and the final remaining byte
+//! incremented by one (the smallest string that is NOT prefixed by `lower`).
+//! Handles the common single-increment case; does not attempt every possible
+//! carry/overflow edge case DuckDB's internal encoder might produce.
+static bool IsPrefixRangeUpperBound(const string &lower, const string &upper) {
+	if (lower.empty()) {
+		return false;
+	}
+	size_t end = lower.size();
+	while (end > 0 && static_cast<unsigned char>(lower[end - 1]) == 0xFF) {
+		end--;
+	}
+	if (end == 0) {
+		return false;
+	}
+	string expected = lower.substr(0, end - 1);
+	expected += static_cast<char>(static_cast<unsigned char>(lower[end - 1]) + 1);
+	return upper == expected;
+}
+
+bool LikeSelectivity::TryGetLikeSelectivity(const Expression &expr, double &selectivity_out) {
+	// FilterCombiner rewrites simple prefix patterns ('word%') into a range:
+	// (col >= 'word') AND (col < '<word, last byte incremented>'). Recognize
+	// that specific shape and reconstruct the original prefix pattern.
+	// NOTE: in this DuckDB version, comparisons (>=, <) are represented as
+	// BoundFunctionExpression, not a separate expression class - use the
+	// BoundComparisonExpression static helpers (Left/Right/IsComparison) to
+	// inspect them, and the child's own GetExpressionType() for which
+	// comparison it is (kept in sync with the function via SetType/FlipType).
+	if (expr.GetExpressionClass() == ExpressionClass::BOUND_CONJUNCTION) {
+		auto &conj = expr.Cast<BoundConjunctionExpression>();
+		if (conj.GetExpressionType() != ExpressionType::CONJUNCTION_AND) {
+			return false;
+		}
+		auto &conj_children = conj.GetChildren();
+		if (conj_children.size() != 2) {
+			return false;
+		}
+		string lower_bound, upper_bound;
+		bool has_lower = false, has_upper = false;
+		for (auto &child : conj_children) {
+			if (child->GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {
+				return false;
+			}
+			if (!BoundComparisonExpression::IsComparison(*child)) {
+				return false;
+			}
+			auto &func_expr = child->Cast<BoundFunctionExpression>();
+			auto &right_expr = BoundComparisonExpression::Right(func_expr);
+			if (right_expr.GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+				return false;
+			}
+			auto &val = right_expr.Cast<BoundConstantExpression>().GetValue();
+			if (val.IsNull() || val.type().id() != LogicalTypeId::VARCHAR) {
+				return false;
+			}
+			auto bound_str = StringValue::Get(val);
+			auto cmp_type = child->GetExpressionType();
+			if (cmp_type == ExpressionType::COMPARE_GREATERTHANOREQUALTO) {
+				lower_bound = bound_str;
+				has_lower = true;
+			} else if (cmp_type == ExpressionType::COMPARE_LESSTHAN) {
+				upper_bound = bound_str;
+				has_upper = true;
+			} else {
+				return false;
+			}
+		}
+		if (has_lower && has_upper && IsPrefixRangeUpperBound(lower_bound, upper_bound)) {
+			string reconstructed_pattern = lower_bound + "%";
+			return LikeSelectivity::Get().TryLookup(reconstructed_pattern, selectivity_out);
+		}
+		return false;
+	}
+
+	if (expr.GetExpressionClass() == ExpressionClass::BOUND_OPERATOR &&
+	    expr.GetExpressionType() == ExpressionType::OPERATOR_NOT) {
+		// A simple single-wildcard NOT LIKE pattern (e.g. NOT LIKE '%word%') gets
+		// optimizer-transformed into "NOT contains(col, 'word')" rather than staying
+		// as the literal "!~~" operator. Recurse into the positive child expression
+		// and negate its selectivity (1 - selectivity), same as the "!~~" case below.
+		auto &op_expr = expr.Cast<BoundOperatorExpression>();
+		auto &children = op_expr.GetChildren();
+		if (children.size() != 1) {
+			return false;
+		}
+		double positive_selectivity;
+		if (TryGetLikeSelectivity(*children[0], positive_selectivity)) {
+			selectivity_out = 1.0 - positive_selectivity;
+			return true;
+		}
+		return false;
+	}
+
+	if (expr.GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {
+		return false;
+	}
+	auto &func = expr.Cast<BoundFunctionExpression>();
+	auto &children = func.GetChildren();
+	if (children.size() != 2) {
+		return false;
+	}
+
+	auto &pattern_expr = *children[1];
+	if (pattern_expr.GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+		// non-constant pattern (e.g. a correlated column): nothing to look up
+		return false;
+	}
+	auto &pattern_value = pattern_expr.Cast<BoundConstantExpression>().GetValue();
+	if (pattern_value.IsNull() || pattern_value.type().id() != LogicalTypeId::VARCHAR) {
+		return false;
+	}
+	auto &raw = StringValue::Get(pattern_value);
+
+	// DuckDB's LikeOptimizationRule transforms LIKE patterns:
+	// - '%word%' -> contains(col, 'word')     [strip both wildcards]
+	// - 'word%'  -> prefix(col, 'word')       [strip trailing wildcard]
+	// - '%word'  -> suffix(col, 'word')       [strip leading wildcard]
+	// - simple patterns stay as ~~ (LIKE operator)
+	//
+	// FilterCombiner also transforms prefix patterns into ranges:
+	// - 'word%'  -> col >= 'word' AND col < '<word with last char incremented>'
+	//
+	// We reconstruct the original LIKE pattern from these transformed forms
+	// to do exact match lookup in the selectivity file.
+	// 
+	// NOT LIKE ("!~~") and GLOB variants ("~~~", "!~~~") are intentionally left unhandled.
+	auto &name = func.Function().GetName();
+	string pattern;
+
+	if (name == "~~") {
+		// Original LIKE pattern, no transformation needed
+		pattern = raw;
+	} else if (name == "!~~") {
+		// Original NOT LIKE pattern: look up the positive pattern, then negate.
+		double positive_selectivity;
+		if (LikeSelectivity::Get().TryLookup(raw, positive_selectivity)) {
+			selectivity_out = 1.0 - positive_selectivity;
+			return true;
+		}
+		return false;
+	} else if (name == "contains") {
+		// Reconstructed from '%word%' pattern (both wildcards stripped)
+		pattern = "%" + raw + "%";
+	} else if (name == "prefix") {
+		// Reconstructed from 'word%' pattern (trailing wildcard stripped)
+		pattern = raw + "%";
+	} else if (name == "suffix") {
+		// Reconstructed from '%word' pattern (leading wildcard stripped)
+		pattern = "%" + raw;
+	} else if (name == ">=") {
+		// Reconstructed from range optimization of 'word%' pattern
+		// The >= contains the prefix part of what was 'word%'
+		pattern = raw + "%";
+	} else {
+		return false;
+	}
+
+	// Do exact match lookup in the file
+	return LikeSelectivity::Get().TryLookup(pattern, selectivity_out);
+}
+
+} // namespace duckdb
